digraph HybridCascade {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=10;
    labelloc="t";
    label="Hybrid Cascade Architecture (vertical view, default cascade mode)";
    bgcolor="white";
    nodesep="0.45";
    ranksep="0.55";
    concentrate=false;

    node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#EDF3FB", color="#3E5C8A", margin="0.12,0.06"];
    edge [fontname="Helvetica", fontsize=8, color="#3C3C3C", arrowsize=0.7, penwidth=1.1];

    start [label="Input frame\n(BGR + optional metadata)", shape=parallelogram, fillcolor="#F6F8FB", color="#666666"];
    gray [label="preprocess\ncv.cvtColor(BGR->GRAY)"];
    detector [label="Face detector\ncreate_face_detector(backend='yunet')\n--> Detection(box, landmarks, score)", fillcolor="#E8F4EA", color="#2E7D32"];
    noface [label="No detection\n-> no prediction", shape=ellipse, fillcolor="#FDECEA", color="#B00020"];

    sample [label="make_sample\n( largest face )\nshared FaceSample", fillcolor="#E6EEF7", color="#355A84"];

    quality [label="compute_quality\n5 probes + flags\nblur, low_light, noise, off_pose, small_face"];

    lbph [label="LBPHAdapter.score\nnormalize + predict_collect\ndistance, margin, lbph_far\nlower distance is better", fillcolor="#FFF6E5", color="#B36B00"];

    gate [label="decide_escalation\nInputs: lbph_distance, lbph_margin, quality.any_flag", fillcolor="#EAE7FB", color="#5C4FA3"];

    lbph_accept [label="LBPH confident accept\n(distance <= tau_accept)", fillcolor="#E8F5E9", color="#2E7D32"];
    lbph_reject [label="LBPH confident reject\n(distance >= tau_reject)", fillcolor="#F3E5F5", color="#6A1B9A"];
    escalate [label="Escalate to SFace\n- quality flag\n- tau_accept < distance < tau_reject\n- margin < 0.05", fillcolor="#FFF3E0", color="#EF6C00"];

    sface [label="SFaceAdapter.score\nalignCrop with YuNet landmarks\n-> gallery.match()", fillcolor="#E0F7FA", color="#00796B"];

    final_lbph [label="HybridDecision\nengine=LBPH\nname + quality summary", fillcolor="#E8F5E9", color="#2E7D32"];
    final_sface [label="HybridDecision\nengine=SFace\nname + cosine + l2 + far\nescalated=True", fillcolor="#E0F2F1", color="#00796B"];

    cfg [label="build_hybrid()\nload thresholds.json\nLBPH model + labels\nSFace model/gallery/impostors", shape=folder, fillcolor="#F0F4FF", color="#3B4F7A"];
    output [label="Downstream sink\nUI, logs, benchmarks\nescalated flag + engine", shape=parallelogram, fillcolor="#F7F7F7", color="#4E4E4E"];

    // Main flow
    start -> gray -> detector -> sample;
    detector -> noface [label="if empty", color="#A0002A", fontsize=8];
    sample -> quality;
    sample -> lbph;

    quality -> gate;
    lbph -> gate [label="distance, margin"];

    gate -> lbph_accept [label="confident_accept"];
    gate -> lbph_reject [label="confident_reject"];
    gate -> escalate [label="any escalation condition\nquality/ambiguous/low margin"];

    lbph_accept -> final_lbph;
    lbph_reject -> final_lbph [label="name = Unknown + reason"];

    escalate -> sface;
    sface -> final_sface;

    final_lbph -> output;
    final_sface -> output;

    // Layout control for vertical emphasis
    {rank=same; start; gray;}
    {rank=same; sample; cfg;}
    {rank=same; lbph; quality;}
    {rank=same; gate;}
    {rank=same; lbph_accept; lbph_reject; escalate;}
    {rank=same; final_lbph; final_sface;}

    threshold_legend [label="Frozen thresholds\n(2026-08-02)\ntau_accept=67.03325520645528\ntau_reject=140.13\nmargin_min=0.05", shape=note, fillcolor="#FCFAE8", color="#6D4C41"];
    gate -> threshold_legend [style=dotted, color="#8D6E63", arrowhead=none, minlen=2];
}
