digraph HybridCascade {
  graph [
    layout=neato,
    outputorder=edgesfirst,
    bgcolor="white",
    pad="0.28",
    margin="0",
    overlap=true,
    splines=polyline,
    notranslate=true
  ];

  node [
    pin=true,
    fontname="Arial",
    fontsize=11,
    color="#263746",
    fontcolor="#17222c",
    penwidth=1.6
  ];

  edge [
    fontname="Arial",
    fontsize=9,
    color="#344a5e",
    fontcolor="#344a5e",
    penwidth=1.45,
    arrowsize=0.72
  ];

  Start [
    pos="85,510!",
    shape=circle,
    fixedsize=true,
    width=0.23,
    height=0.23,
    label="",
    style=filled,
    fillcolor="#17222c",
    color="#17222c"
  ];

  InputLabel [
    pos="85,478!",
    shape=plaintext,
    label=<<FONT POINT-SIZE="10"><B>Input Frame</B></FONT>>
  ];

  Preprocess [
    pos="85,625!",
    shape=box,
    fixedsize=true,
    width=2.12,
    height=0.78,
    style="rounded,filled",
    fillcolor="#edf5fa",
    color="#3f7195",
    label=<<FONT POINT-SIZE="14"><B>Preprocessing</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Detect and align face</FONT>>
  ];

  Stage1 [
    pos="335,625!",
    shape=box,
    fixedsize=true,
    width=2.55,
    height=0.90,
    style="rounded,filled",
    fillcolor="#fff8e8",
    color="#a67618",
    label=<<FONT POINT-SIZE="9" COLOR="#86600f"><B>STAGE 1</B></FONT><BR/><FONT POINT-SIZE="14"><B>LBPH Inference</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Fast path</FONT>>
  ];

  Gate [
    pos="335,470!",
    shape=diamond,
    fixedsize=true,
    width=2.25,
    height=1.18,
    style=filled,
    fillcolor="#f2f4f6",
    color="#52677a",
    label=<<FONT POINT-SIZE="14"><B>Gate</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Escalation needed?</FONT>>
  ];

  TriggerNote [
    pos="700,505!",
    shape=note,
    fixedsize=true,
    width=2.55,
    height=1.40,
    style=filled,
    fillcolor="#fbfcfd",
    color="#758492",
    penwidth=1.25,
    label=<<FONT POINT-SIZE="11"><B>Escalation triggers</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">1. Quality issue</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">2. Mid-band distance</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="9">3. Weak score separation</FONT>>
  ];

  LBPHCheck [
    pos="145,292!",
    shape=diamond,
    fixedsize=true,
    width=2.15,
    height=1.12,
    style=filled,
    fillcolor="#fffdf6",
    color="#a67618",
    label=<<FONT POINT-SIZE="12"><B>LBPH Score</B></FONT><BR/><FONT POINT-SIZE="12"><B>Check</B></FONT>>
  ];

  Stage2 [
    pos="455,292!",
    shape=box,
    fixedsize=true,
    width=2.55,
    height=0.90,
    style="rounded,filled",
    fillcolor="#edf7f3",
    color="#39765f",
    label=<<FONT POINT-SIZE="9" COLOR="#326650"><B>STAGE 2</B></FONT><BR/><FONT POINT-SIZE="14"><B>SFace Inference</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Hard cases only</FONT>>
  ];

  SFaceCheck [
    pos="735,292!",
    shape=diamond,
    fixedsize=true,
    width=2.15,
    height=1.12,
    style=filled,
    fillcolor="#f7fbf9",
    color="#39765f",
    label=<<FONT POINT-SIZE="12"><B>SFace Match</B></FONT><BR/><FONT POINT-SIZE="12"><B>Check</B></FONT>>
  ];

  LBPHAccept [pos="55,104!", shape=doublecircle, fixedsize=true, width=0.34, height=0.34, label="", style=filled, fillcolor="#214d37", color="#214d37", penwidth=1.35];
  LBPHReject [pos="235,104!", shape=doublecircle, fixedsize=true, width=0.34, height=0.34, label="", style=filled, fillcolor="#743838", color="#743838", penwidth=1.35];
  SFaceAccept [pos="645,104!", shape=doublecircle, fixedsize=true, width=0.34, height=0.34, label="", style=filled, fillcolor="#214d37", color="#214d37", penwidth=1.35];
  SFaceReject [pos="825,104!", shape=doublecircle, fixedsize=true, width=0.34, height=0.34, label="", style=filled, fillcolor="#743838", color="#743838", penwidth=1.35];

  LBPHAcceptLabel [pos="55,48!", shape=plaintext, label=<<FONT POINT-SIZE="10"><B>LBPH Accept</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Known identity</FONT>>];
  LBPHRejectLabel [pos="235,48!", shape=plaintext, label=<<FONT POINT-SIZE="10"><B>LBPH Reject</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Unknown person</FONT>>];
  SFaceAcceptLabel [pos="645,48!", shape=plaintext, label=<<FONT POINT-SIZE="10"><B>SFace Accept</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Verified identity</FONT>>];
  SFaceRejectLabel [pos="825,48!", shape=plaintext, label=<<FONT POINT-SIZE="10"><B>SFace Reject</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#52616d">Unverified identity</FONT>>];

  NoTriggerLabel [pos="196,487!", shape=plaintext, fontcolor="#536574", label=<<FONT POINT-SIZE="9"><B>[No trigger]</B></FONT>>];
  TriggerLabel [pos="399,399!", shape=plaintext, fontcolor="#356a7f", label=<<FONT POINT-SIZE="9"><B>[Trigger]</B></FONT>>];
  AcceptLabel1 [pos="29,217!", shape=plaintext, fontcolor="#2c6749", label=<<FONT POINT-SIZE="9"><B>[Accept]</B></FONT>>];
  RejectLabel1 [pos="263,217!", shape=plaintext, fontcolor="#873d3d", label=<<FONT POINT-SIZE="9"><B>[Reject]</B></FONT>>];
  PassLabel [pos="614,217!", shape=plaintext, fontcolor="#2c6749", label=<<FONT POINT-SIZE="9"><B>[Pass]</B></FONT>>];
  FailLabel [pos="851,217!", shape=plaintext, fontcolor="#873d3d", label=<<FONT POINT-SIZE="9"><B>[Fail]</B></FONT>>];

  G_LBPH [pos="145,470!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  G_S1 [pos="335,385!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  G_S2 [pos="455,385!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  G_N1 [pos="555,470!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  G_N2 [pos="555,505!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  LBA [pos="55,292!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  LBR [pos="235,292!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  SFA [pos="645,292!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];
  SFR [pos="825,292!", shape=point, fixedsize=true, width=0.01, height=0.01, label="", style=invis];

  Start:n -> Preprocess:s;
  Preprocess:e -> Stage1:w;
  Stage1:s -> Gate:n;

  Gate:w -> G_LBPH [arrowhead=none];
  G_LBPH -> LBPHCheck:n;

  Gate:s -> G_S1 [arrowhead=none, color="#356a7f"];
  G_S1 -> G_S2 [arrowhead=none, color="#356a7f"];
  G_S2 -> Stage2:n [color="#356a7f"];

  Gate:e -> G_N1 [dir=none, style=dashed, color="#7b8791", penwidth=1.15];
  G_N1 -> G_N2 [dir=none, style=dashed, color="#7b8791", penwidth=1.15];
  G_N2 -> TriggerNote:w [dir=none, style=dashed, color="#7b8791", penwidth=1.15];

  Stage2:e -> SFaceCheck:w [color="#356a7f"];

  LBPHCheck:w -> LBA [arrowhead=none, color="#2c6749"];
  LBA -> LBPHAccept:n [color="#2c6749"];
  LBPHCheck:e -> LBR [arrowhead=none, color="#873d3d"];
  LBR -> LBPHReject:n [color="#873d3d"];

  SFaceCheck:w -> SFA [arrowhead=none, color="#2c6749"];
  SFA -> SFaceAccept:n [color="#2c6749"];
  SFaceCheck:e -> SFR [arrowhead=none, color="#873d3d"];
  SFR -> SFaceReject:n [color="#873d3d"];
}
