digraph HybridCascadeCanonical {
  rankdir=TB;
  splines=polyline;
  fontsize=11;
  fontname="Helvetica";
  labelloc="t";
  label="Hybrid Cascade (canonical, simplified)";
  nodesep=0.45;
  ranksep=0.7;
  margin=0.18;

  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", color="#334E68", fillcolor="#ECF4FB", width=2.35, margin="0.12,0.08"];
  edge [fontname="Helvetica", fontsize=8, color="#3A3A3A", arrowsize=0.75];

  Input      [label="Input image"];
  Preprocess [label="Preprocessing"];
  Detect     [label="Face Detection"];
  Prepare    [label="Sample Builder"];
  LBPH       [label="LBPH Inference"];
  Gate       [label="Gate", shape=diamond, fillcolor="#EEF1F5", color="#5B5B5B"];
  AcceptLBPH [label="Output via\nLBPH Inference"];
  Escalate   [label="Escalation" ];
  SFace      [label="SFace Inference"];
  Final      [label="Final Decision", shape=parallelogram, fillcolor="#F4F6F8", color="#4A4A4A"];

  {rank=same; Input;}
  {rank=same; Preprocess;}
  {rank=same; Detect;}
  {rank=same; Prepare; LBPH;}
  {rank=same; Gate;}
  {rank=same; AcceptLBPH; Escalate;}
  {rank=same; SFace; Final;}

  Input -> Preprocess -> Detect -> Prepare -> LBPH -> Gate;
  Gate -> AcceptLBPH;
  Gate -> Escalate;
  Escalate -> SFace -> Final;
  AcceptLBPH -> Final;

  // Small explanatory note to keep this readable in small widths
  note [label="Clear match = direct output\nUnclear match = verification path", shape=note, fillcolor="#FCFCFC", color="#777777", fontsize=8, width=2.0];
  Gate -> note [style=dotted, arrowhead=none, color="#9a9a9a", minlen=2];
}
